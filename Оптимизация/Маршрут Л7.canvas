    {
      "id": "route-title",
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 880,
      "height": 180,
      "text": "# Л7 · Маршрут\nСлева направо — зависимости. Номера: по колонкам, затем сверху вниз.\n«Вне экзамена»: у всех заметок блока «экзамен: нет»; зависимости сохраняются."
    },
    {
      "id": "key-geometry",
