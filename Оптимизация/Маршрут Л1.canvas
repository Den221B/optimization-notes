    {
      "id": "route-title",
      "type": "text",
      "x": 0,
      "y": 0,
      "width": 880,
      "height": 180,
      "text": "# Л1 · Маршрут\nСлева направо — зависимости. Номера: по колонкам, затем сверху вниз.\n«Вне экзамена»: у всех заметок блока «экзамен: нет»; зависимости сохраняются."
    },
    {
      "id": "key-language",
      "type": "text",
      "x": 14,
      "y": 212,
      "width": 880,
      "height": 80,
      "color": "#23D5DF",
      "text": "**Постановка**"
    },
